# 复制为 config.env 并填入你自己的值（不要提交到公开仓库）
# 然后运行： set -a && source config.env && set +a && ./venv/bin/python server.py

# 服务端口（与前端同源，PWA 才能读取 /api/news）
PORT=8000

# 每日推送时间（24小时制），默认早 7:30，确保在 8 点前完成
PUSH_HOUR=7
PUSH_MINUTE=30

# 抓取关键词（逗号分隔），可自由增删
NEWS_QUERIES=Amazon seller policy,Amazon FBA update,Amazon sellers news,Amazon Seller Central,amazon.com marketplace

# ── 推送方式（任选其一或都填）──

# 1) Telegram：@BotFather 建 bot 拿 token，给 @userinfobot 拿 chat_id
TG_TOKEN=
TG_CHAT_ID=

# 2) 通用 GET Webhook（覆盖 Bark / 推送加 / Server酱 等）
#    Bark 示例:  https://api.day.app/<你的KEY>/xiaoliang/{title}/{text}
#    推送加示例: http://www.pushplus.plus/send?token=<你的TOKEN>&title={title}&content={text}
#    支持占位符 {title} {text}（会自动 URL 编码）
PUSH_URL=

# 调用 /api/refresh 手动刷新时所需的令牌（留空则无需鉴权，仅内网使用）
REFRESH_TOKEN=
